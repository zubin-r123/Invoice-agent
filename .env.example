GROQ_API_KEY=

# Dev-only: cache extraction results in .cache/ by file hash, skipping the Groq call on a
# repeat run of the same PDF. Leave unset (or 0) in production/Render so extraction is always live.
EXTRACT_CACHE=0

# Dev-only: never call Groq at all. Extraction reads .cache/ only (fails cleanly on a miss) and
# explain() returns a deterministic rule-based summary. Leave unset (or 0) in production/Render.
MOCK_LLM=0
